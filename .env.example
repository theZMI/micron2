# Base settings:
# local - локальная разработка (SMS пишутся в tmp/sms_mockup.log, геолокация - заглушка), production - боевой сервер
ENV=local
DEBUG_MODE=1
ERROR_LOG_FILE=php_errors.log

# Domain:
SITE_ROOT_URL=http://localhost:98/
DOMAIN_COOKIE=
# Домены, которым разрешены кросс-доменные запросы (CORS), через запятую. Пусто - только свой домен
CORS_ALLOWED_ORIGINS=
# IP прокси перед сайтом (nginx, балансировщик), через запятую. Только от них принимаем X-Forwarded-For. Пусто - сайт открыт напрямую
TRUSTED_PROXIES=

# DB:
DATABASE_DSN=mysqli://user:pass@mysqldb/app_db?charset=utf8mb4
DATABASE_LOG_FILE=db_errors.log

# Admin area (первый админ создаётся из этих данных, если в БД ещё нет админов. Обязательно задайте свой пароль!)
ADMIN_DEFAULT_LOGIN="admin"
ADMIN_DEFAULT_PASSWORD=""

# Соли нужны только для входа пользователей со старыми md5-хешами паролей (новые пароли хранятся через password_hash)
ADMIN_SALT=""
USER_SALT=""

# Ключ для запуска задач /_cron/* по расписанию: /_cron/db_backup?key=CRON_SECRET (сгенерируйте: openssl rand -hex 32)
CRON_SECRET=""

# Если задан, то apk-приложение скачивается только по ссылке /get_app?key=APP_DOWNLOAD_KEY (для внутренних приложений)
APP_DOWNLOAD_KEY=""

# Emailer:
EMAIL_ADDRESS=""
EMAIL_NAME="Email from Micron"
EMAIL_PASSWORD=""
EMAIL_HOST=""
EMAIL_PORT=465

# Telegram-бот: токен от @BotFather и секрет, который передаётся в setWebhook (secret_token)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

# Push (OneSignal):
PUSH_ONESIGNAL_APP_ID=""
PUSH_ONESIGNAL_REST_API_KEY=""

# SMS:
SMSC_SENDER=""
SMSC_LOGIN=""
SMSC_PASSWORD=""
SMSRU_SENDER=""
SMSRU_LOGIN=""
SMSRU_PASSWORD=""

# Pay systems:
PAY_SYSTEM_SBER_USERNAME=""
PAY_SYSTEM_SBER_PASSWORD=""
PAY_SYSTEM_YOOKASSA_SHOP_ID=""
PAY_SYSTEM_YOOKASSA_PASSWORD=""

# Google reCAPTCHA v2 (компоненты _dev/simple_captcha_code_2*): https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
