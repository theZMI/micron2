# Выключить обработку модулем mod_charset
<IfModule mod_charset.c>
    CharsetDisable On
</IfModule>

# Выставить кодировку по умолчанию стандартными средствами apache
AddDefaultCharset UTF-8

# Не показывать файлы в пустом каталоге
Options -Indexes

# Запрещаем запуск CGI-скриптов
Options -ExecCGI -Indexes

# По умолчанию запускать index.php в папке
DirectoryIndex index.php

# Все запросы (кроме заданного списка исключений) вести через /index.php
RewriteEngine on
RewriteBase /
# Напрямую (без index.php) отдаём только склеенные css/js, qr-коды, файлы CKEditor и сборку webpack.
# Остальное содержимое tmp/ (логи и пр.) и lib/ (php-классы) снаружи недоступно
RewriteCond $1 !^(index\.php|robots\.txt|favicon\.ico|tmp/(_auto_merge_css_js|_admin_auto_merge_css_js|qrcodes)/|lib/CKEditor/|i/webpack/)
RewriteRule ^(.*)$ /index.php?micron_query=$1 [L,QSA]

# Максимальный размер файла для загрузки - 50Мб
php_value upload_max_filesize 50M
php_value post_max_size 50M

# Сайт можно встраивать в iframe только на своих же страницах (защита от clickjacking)
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"

# Служебные файлы проекта не отдаём
<FilesMatch "^(\.env.*|composer\.(json|lock)|Makefile|README\.md|\.gitignore)$">
    Require all denied
</FilesMatch>

# Кешируем статику на год. JSON/XML сюда не добавляем: mod_expires действует и на ответы PHP (например, API), а их кешировать нельзя
<IfModule mod_expires.c>
    ExpiresActive On

    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|svg|webp|css|js|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
</IfModule>
